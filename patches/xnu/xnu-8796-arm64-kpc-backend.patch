+/*
+ * arm64 kernel performance counter backend.
+ *
+ * The xnu-8796 open source drop lists osfmk/arm64/kpc.c in osfmk/conf/files.arm64
+ * but does not ship the file; only the x86_64 backend is published. These are
+ * the arm64 hooks that osfmk/kern/kpc_common.c, kern_kpc.c and osfmk/arm64/cpu.c
+ * call.
+ *
+ * This board drives no ARM performance monitor unit, so every hook reports that
+ * there are no counter classes, nothing is configured and nothing is running.
+ * The shape of the answers matters: kpc_common.c reads kpc_get_classes() and
+ * the count hooks before it touches any counter, and cpu.c calls kpc_idle on
+ * every idle entry, so these have to be cheap and total rather than partial.
+ */
+#include <kern/kpc.h>
+#include <machine/machine_kpc.h>
+#include <stdint.h>
+
+/* Whether the hardware can capture the program counter. It cannot here. */
+int kpc_pc_capture = 0;
+
+void
+kpc_arch_init(void)
+{
+}
+
+uint32_t
+kpc_get_classes(void)
+{
+	return 0;
+}
+
+int
+kpc_get_pmu_version(void)
+{
+	return 0;
+}
+
