# iOS 16.5 kernel configuration fragment.
# CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script.
#
# Applied as the OS layer, after arch:configs/common.config and
# soc:configs/sm8550.config and before the device defconfig, which applies last.
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
# mockfs is a test filesystem whose fixture archive has no builder in this
# tree yet, and vfs_conf.o registers it unconditionally once the flag is on.
# CONFIG_XNU_SOURCE_MOCKFS is not set
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
